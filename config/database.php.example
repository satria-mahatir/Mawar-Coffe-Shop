<?php
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
if (empty($_SESSION['frontend_csrf_token'])) {
    $_SESSION['frontend_csrf_token'] = bin2hex(random_bytes(32));
}

// Matikan display_errors di semua environment
// Error tetap dicatat ke log server, bukan ditampilkan ke user
ini_set('display_errors', 0);
ini_set('log_errors', 1);
error_reporting(E_ALL);

// Konfigurasi Database (Ganti dengan kredensial server production)
// Muat .env jika ada
$env_file = __DIR__ . '/../.env';
if (file_exists($env_file)) {
    $env_vars = parse_ini_file($env_file);
    if ($env_vars) {
        foreach ($env_vars as $k => $v) {
            putenv("$k=$v");
            $_ENV[$k] = $v;
        }
    }
}

// Konfigurasi Database (Dari env atau default fallback)
$host     = getenv('DB_HOST') ?: $_ENV['DB_HOST'] ?? "localhost";
$user     = getenv('DB_USER') ?: $_ENV['DB_USER'] ?? "root";
$password = getenv('DB_PASS') ?: $_ENV['DB_PASS'] ?? "";
$db       = getenv('DB_NAME') ?: $_ENV['DB_NAME'] ?? "db_warkop_mawar";

$koneksi = mysqli_connect($host, $user, $password, $db);

if (!$koneksi) {
    error_log('Koneksi DB gagal: ' . mysqli_connect_error());
    die("Terjadi kesalahan sistem. Silakan coba lagi.");
}
?>
